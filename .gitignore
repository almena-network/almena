# The agent, staged into the bundle by `task agent:stage`. It is built from its own repository
# and is not committed here; the directory and its note are, because the bundle names it and a
# build with nothing staged has to keep working.
/src-tauri/resources/almena-agent/*
!/src-tauri/resources/almena-agent/.keep
